# =========================================================================
# SIKILAT SKB ASN — Template Environment Variables (Production & Staging)
# =========================================================================
# PENTING:
# 1. JANGAN PERNAH memasukkan SUPABASE_SERVICE_ROLE_KEY di frontend!
# 2. Gunakan HANYA URL dan ANON_KEY. Semua hak akses dijaga oleh Supabase RLS.
# 3. Salin file ini menjadi .env.local untuk pengembangan lokal.
# 4. Untuk deployment di Vercel / Netlify / Cloudflare Pages, masukkan
#    variabel-variabel di bawah ini ke menu Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
